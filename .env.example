# Copy to `.env` and fill in to enable the real AI provider. `.env` is gitignored.
# Leave RELAY_AI_PROVIDER=mock (or unset) to run fully offline with the deterministic mock.

# Bearer token for the platform APIs (blank disables auth)
RELAY_AUTH_TOKEN=relay-dev-token

# AI provider: mock (default) | openrouter (any OpenAI-compatible endpoint)
RELAY_AI_PROVIDER=mock
RELAY_AI_BASE_URL=https://openrouter.ai/api/v1
RELAY_AI_MODEL=meta-llama/llama-3.1-8b-instruct
RELAY_AI_API_KEY=
